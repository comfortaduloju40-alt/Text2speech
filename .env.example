# Telegram
BOT_TOKEN=your_bot_token_from_botfather
WEBHOOK_URL=https://your-app.up.railway.app
WEBHOOK_SECRET=choose_a_random_secret_string

# Database
# Local dev (SQLite):
DATABASE_URL=sqlite:///./tts_bot.db
# Railway production (Postgres) — injected automatically by Railway's Postgres plugin, don't set manually

# TTS engine: "gtts" (free, no key needed) or "openai" (higher quality, needs API key)
TTS_ENGINE=gtts
OPENAI_API_KEY=
OPENAI_TTS_MODEL=tts-1

# Safety cap on how much text one request can convert
MAX_TEXT_LENGTH=4000

LOG_LEVEL=INFO
ENVIRONMENT=development
